# Canonical repository text policy
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary scientific/model/image artifacts
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.pdf binary
*.zip binary
*.npz binary
*.npy binary
*.pt binary
*.pth binary
*.ckpt binary
*.onnx binary
*.rss binary
*.rsr binary
