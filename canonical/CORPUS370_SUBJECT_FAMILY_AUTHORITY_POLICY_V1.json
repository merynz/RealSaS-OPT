    "distance_magnitude": "distance_to_actual_boundary_of_that_same_explicit_solid",
    "forbidden_promotions": [
      "component_local_parity_to_global_sign",
      "nearest_component_sign_to_global_occupancy",
      "union_occupancy_times_raw_surface_udf_as_exact_union_sdf",
      "silent_hole_closing",
      "silent_decorative_geometry_drop",
      "missing_sign_rows_encoded_as_zero"
    ],
    "open_or_modular_source_policy": "GLOBAL_SOLID_SDF_MASKED_UNLESS_A_SEPARATE_EXPLICIT_SOLID_COURT_PASSES"
  },
  "model_routes": {
