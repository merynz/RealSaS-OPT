  "semantics": {
    "PASS": "Current independent court proves the exact family claim for the exact source/import/producer/consumer binding.",
    "MASKED": "The family is scientifically inapplicable or absent for this subject; the target is omitted from the loss and must never be encoded as numeric zero.",
    "FAIL": "The family was tested under the current court and failed its fixed contract.",
    "QUARANTINED": "Source/provenance/lineage/semantic ambiguity prevents consumption until explicitly resolved.",
    "UNKNOWN": "No current court result is bound. UNKNOWN is never training-consumable."
