  "families": [
    "SOURCE_IMPORT",
    "CAMERA_OBSERVATION",
    "SURFACE_GEOMETRY_UDF",
    "GLOBAL_SOLID_SDF",
    "SURFACE_NORMALS",
    "APPEARANCE_CAA",
    "VISIBILITY_OCCLUSION",
    "RAY_COMPOSITING",
    "MECHANICAL_SURFACE_TOPOLOGY",
    "CAUSAL_RESPONSE",
    "RIG_HIERARCHY",
    "SKIN_WEIGHTS",
    "ANIMATION_KINEMATICS",
    "TESSA_TEACHER"
