# Copy to deploy/product/.env locally. Never commit real secrets.
# Build identity must be the exact reviewed canonical-main SHA when production is enabled.
REALSAS_SOURCE_CODE_SHA=0000000000000000000000000000000000000000

# Production/staging infrastructure endpoints reachable from the container network.
REALSAS_DATABASE_URL=postgres://realsas:replace-me@postgres.internal:5432/realsas?sslmode=require
REALSAS_TEMPORAL_ADDRESS=temporal.internal:7233
REALSAS_TEMPORAL_NAMESPACE=default

# Generate independent high-entropy values. These remain server-side only.
REALSAS_PRODUCT_GATEWAY_TOKEN=replace-with-random-product-gateway-token
REALSAS_OPERATOR_TOKEN=replace-with-random-operator-token

# Public shell is published only on host loopback by compose. A TLS/authenticated
# reverse proxy may be attached later when product naming/domain policy is frozen.
REALSAS_WEB_PORT=8765

# Fail closed by default. Set to 1 only after release channel, exact production
# model releases, engine worker and both materializers are installed and checked.
REALSAS_PRODUCT_COMPILE_ENABLED=0

# Worker materializers are deliberately unbound in this deployment skeleton.
# They must be executable paths/commands inside the product worker image.
REALSAS_SOURCE_MATERIALIZER_COMMAND=
REALSAS_WORKSPACE_MATERIALIZER_COMMAND=

# Capability-specific engine image. Production MIRA admission may require a
# CUDA/BF16-capable image/host; do not substitute the CPU developer engine.
REALSAS_ENGINE_IMAGE=realsas-engine:unbound
