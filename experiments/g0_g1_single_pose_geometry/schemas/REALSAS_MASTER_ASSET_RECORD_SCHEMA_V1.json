{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realsas.ai/schemas/REALSAS_MASTER_ASSET_RECORD_SCHEMA_V1.json",
  "title": "RealSaS Master Asset Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonical_asset_id", "source_variants", "legal_state", "primary_geometry", "render_sets", "split", "integrity"],
  "properties": {
    "schema_version": {"const": "realsas.master_asset_record.v1"},
    "canonical_asset_id": {"type": "string", "minLength": 1},
    "source_variants": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "source_registry_id", "source_record_id", "admission_record", "normalized_npz", "technical_audit"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "source_registry_id": {"type": "string", "minLength": 1},
          "source_record_id": {"type": "string", "minLength": 1},
          "decision": {"type": "string"},
          "admission_record": {"$ref": "#/$defs/artifactRef"},
          "normalized_npz": {"$ref": "#/$defs/artifactRef"},
          "technical_audit": {"$ref": "#/$defs/artifactRef"},
          "source_structure": {"oneOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]},
          "raw_source": {"oneOf": [{"$ref": "#/$defs/artifactRef"}, {"type": "null"}]},
          "source_url": {"type": ["string", "null"]},
          "array_inventory": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["name", "dtype", "shape"],
              "properties": {
                "name": {"type": "string"},
                "dtype": {"type": "string"},
                "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}}
              }
            }
          }
        }
      }
    },
    "legal_state": {
      "type": "object", "additionalProperties": false,
      "required": ["all_exportable_variants_pass", "attribution_entries"],
      "properties": {
        "all_exportable_variants_pass": {"const": true},
        "attribution_entries": {"type": "array", "items": {"type": "string"}}
      }
    },
    "primary_geometry": {"$ref": "#/$defs/artifactRef"},
    "render_sets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["render_contract_id", "native_size", "style_family", "semantic_facing", "views"],
        "properties": {
          "render_contract_id": {"type": "string", "minLength": 1},
          "native_size": {"const": 1024},
          "style_family": {"type": "string", "minLength": 1},
          "semantic_facing": {"enum": ["RESOLVED", "UNKNOWN"]},
          "views": {
            "type": "array", "minItems": 8, "maxItems": 8,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["view_index", "yaw_deg", "rgba", "camera", "raster_authority"],
              "properties": {
                "view_index": {"type": "integer", "minimum": 0, "maximum": 7},
                "semantic_label": {"type": ["string", "null"]},
                "yaw_deg": {"type": "number"},
                "rgba": {"$ref": "#/$defs/artifactRef"},
                "camera": {"$ref": "#/$defs/artifactRef"},
                "raster_authority": {"$ref": "#/$defs/artifactRef"}
              }
            }
          }
        }
      }
    },
    "split": {
      "type": "object", "additionalProperties": false, "required": ["master_split"],
      "properties": {
        "master_split": {"enum": ["FIT", "TUNE", "CAL", "DEV", "VALIDATION", "SEALED_QUAL", "EXTERNAL_HOLDOUT", "QA_ONLY", "UNASSIGNED"]},
        "historical_splits": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["unknown_field_loss_count", "all_refs_hashed", "passed"],
      "properties": {
        "unknown_field_loss_count": {"const": 0},
        "all_refs_hashed": {"const": true},
        "passed": {"const": true}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "authority"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "authority": {"enum": ["SOURCE", "NORMALIZED", "DERIVED", "RENDERED"]}
      }
    }
  }
}
