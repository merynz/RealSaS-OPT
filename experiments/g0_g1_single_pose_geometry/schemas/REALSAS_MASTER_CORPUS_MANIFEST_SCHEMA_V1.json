{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realsas.ai/schemas/REALSAS_MASTER_CORPUS_MANIFEST_SCHEMA_V1.json",
  "title": "RealSaS Master Corpus Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "build_id",
    "contract",
    "sources",
    "counts",
    "asset_index",
    "render_contract",
    "split_policy",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "realsas.master_corpus_manifest.v1"},
    "build_id": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "format": "date-time"},
    "contract": {"$ref": "#/$defs/artifactRef"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceSet"}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_records_pre_dedup", "canonical_assets", "duplicate_clusters"],
      "properties": {
        "source_records_pre_dedup": {"type": "integer", "minimum": 0},
        "canonical_assets": {"type": "integer", "minimum": 0},
        "duplicate_clusters": {"type": "integer", "minimum": 0},
        "rendered_assets": {"type": "integer", "minimum": 0}
      }
    },
    "asset_index": {"$ref": "#/$defs/artifactRef"},
    "render_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_width", "native_height", "view_order", "projection_family", "style_families"],
      "properties": {
        "native_width": {"const": 1024},
        "native_height": {"const": 1024},
        "view_order": {
          "const": ["S", "SE", "E", "NE", "N", "NW", "W", "SW"]
        },
        "projection_family": {"type": "string", "minLength": 1},
        "style_families": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "dense_gbuffer_required": {"type": "boolean"},
        "persistent_surface_fallback_min": {"type": "integer", "minimum": 4096}
      }
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["master_possession_does_not_authorize_training", "sealed_fail_closed"],
      "properties": {
        "master_possession_does_not_authorize_training": {"const": true},
        "sealed_fail_closed": {"const": true},
        "notes": {"type": "string"}
      }
    },
    "model_exports": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifactRef"}
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unknown_field_loss_count", "unresolved_seed_identity_count", "all_artifacts_hashed", "passed"],
      "properties": {
        "unknown_field_loss_count": {"const": 0},
        "unresolved_seed_identity_count": {"const": 0},
        "all_artifacts_hashed": {"const": true},
        "passed": {"const": true},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string"}
      }
    },
    "sourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_name", "provider", "revision", "admission_manifest", "admitted_source_records", "split_counts"],
      "properties": {
        "source_name": {"enum": ["Articulation-XL2.0", "RigXL"]},
        "provider": {"type": "string", "minLength": 1},
        "repository": {"type": "string"},
        "revision": {"type": "string", "minLength": 1},
        "source_artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifactRef"}
        },
        "admission_manifest": {"$ref": "#/$defs/artifactRef"},
        "admitted_source_records": {"type": "integer", "minimum": 0},
        "split_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "license": {"type": "string"}
      }
    }
  }
}
