{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realsas.ai/schemas/REALSAS_SOURCE_ADMISSION_SCHEMA_V1.json",
  "title": "RealSaS Source Admission Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_id", "source_registry_id", "source_identity",
    "legal", "technical", "capabilities", "decision"
  ],
  "properties": {
    "schema_version": {"const": "realsas.source_admission.v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "canonical_asset_id": {"type": ["string", "null"]},
    "source_registry_id": {"type": "string", "minLength": 1},
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "source_record_id"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "dataset_or_collection": {"type": "string"},
        "revision": {"type": "string"},
        "source_record_id": {"type": "string", "minLength": 1},
        "uuid": {"type": ["string", "null"]},
        "file_identifier": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"]},
        "source_sha256": {"$ref": "#/$defs/nullableSha"},
        "source_size_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "reason", "classifier_version", "evidence"],
      "properties": {
        "dataset_license": {"type": ["string", "null"]},
        "object_license": {"type": ["string", "null"]},
        "decision": {"enum": ["PASS", "REVIEW", "REJECT"]},
        "reason": {"type": "string", "minLength": 1},
        "classifier_version": {"type": "string", "minLength": 1},
        "attribution_required": {"type": "boolean"},
        "attribution_text": {"type": ["string", "null"]},
        "author": {"type": ["string", "null"]},
        "no_ai_ml_restriction_detected": {"type": "boolean"},
        "retrieved_utc": {"type": ["string", "null"], "format": "date-time"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": {
              "kind": {"enum": ["URL", "FILE", "METADATA_FIELD", "MANUAL_REVIEW", "LICENSE_TEXT_HASH"]},
              "value": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/nullableSha"}
            }
          }
        }
      }
    },
    "technical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry", "rig", "skin", "canonicalization", "render"],
      "properties": {
        "geometry": {"$ref": "#/$defs/gate"},
        "rig": {"$ref": "#/$defs/gate"},
        "skin": {"$ref": "#/$defs/gate"},
        "canonicalization": {"$ref": "#/$defs/gate"},
        "render": {"$ref": "#/$defs/gate"}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iris", "geppetto", "arachne"],
      "properties": {
        "iris": {"type": "boolean"},
        "geppetto": {"type": "boolean"},
        "arachne": {"type": "boolean"}
      }
    },
    "historical_anchor": {"type": ["string", "null"]},
    "split_state": {"type": ["string", "null"]},
    "duplicate_of": {"type": ["string", "null"]},
    "decision": {
      "enum": [
        "ADMIT", "ADMIT_GEOMETRY_ONLY", "QUARANTINE_LEGAL", "QUARANTINE_TECHNICAL",
        "REJECT_LEGAL", "REJECT_TECHNICAL", "SEALED_NOT_EXPORTABLE"
      ]
    },
    "reasons": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE", "PENDING"]},
        "reason": {"type": ["string", "null"]},
        "metrics": {"type": "object", "additionalProperties": true}
      }
    }
  }
}
