      "required_when_role_present": true,
      "authority_kind": "ROLE_OUTPUT",
      "exclusive": true,
      "canonical_transform_id": "motion_solution",
      "data_reduction": "NONE",
      "source_truth_retained": true
    },
    {
      "id": "proof.product_pass_decision",
      "role_id": "proof",
      "required_when_role_present": true,
      "authority_kind": "PRODUCT_PASS_AUTHORITY",
      "exclusive": true,
      "canonical_transform_id": "proof_product_pass_decision",
      "data_reduction": "NONE",
      "source_truth_retained": true
    }
  ]
}
